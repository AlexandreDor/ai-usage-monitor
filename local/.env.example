# ============================================================================
# Codex Usage Monitor — Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#   chmod 600 .env
#
# .env is git-ignored — never commit it.
# ============================================================================

# ----------------------------------------------------------------------------
# Notifications (optional — works 100% locally via direct curl, no server needed)
# ----------------------------------------------------------------------------

# Discord: create a webhook in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK=

# Telegram: both values are required together. chat_id is a non-zero integer
# (negative IDs are valid for groups). Get it from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert thresholds: non-empty comma-separated integers from 0 through 100.
# Each threshold fires ONCE as usage drops below it (no spam).
# Active 5-hour and weekly limit resets also fire once automatically.
ALERT_THRESHOLDS=75,50,25,10,5

# Optional local scripts can react to thresholds independently from Discord and
# Telegram. Indices may range from 1 to 99 and do not need to be contiguous.
# Paths must be absolute executable files; use a wrapper when arguments are
# needed. Events are: 5h:reset, weekly:reset, 5h:<0..100>, weekly:<0..100>.
# A script may handle several events, and several scripts may share an event.
# Uncomment and adjust these examples:
# ALERT_SCRIPT_1=/home/youruser/codex-usage-monitor/local/scripts/reset-worker.sh
# ALERT_SCRIPT_1_EVENTS=5h:reset,weekly:reset
# ALERT_SCRIPT_2=/home/youruser/codex-usage-monitor/local/scripts/reduce-load.sh
# ALERT_SCRIPT_2_EVENTS=5h:50,5h:25,weekly:20

# Scripts run synchronously once per matched action. Failures are warnings and
# are not retried. Timeout range: 1..300 seconds.
ALERT_SCRIPT_TIMEOUT_SECONDS=30

# Rolling history window retained in history.json, from 0.25 through 8760 hours.
# Retention remains entry-count based: ceil(hours * 3600 / poll interval).
HISTORY_RETENTION_HOURS=192

# Loop interval: integer from 1 through 86400 seconds. With 900, checks align
# to :00, :15, :30, and :45.
LOOP_INTERVAL=900

# Codex app-server settings. Collection is non-interactive and does not approve
# repository trust prompts or expose account identity. Timeout: 5..300 seconds.
# Python 3.9+ and system tzdata containing Europe/Paris are required.
CODEX_BIN=codex
CODEX_STATUS_TIMEOUT_SECONDS=20

# HTTP transport bounds. Connect timeout: 1..60 seconds; total timeout: 1..600
# seconds (and not less than connect timeout); retries: 0..5; initial backoff:
# 0..60 seconds. Backoff doubles after each failed attempt.
CURL_CONNECT_TIMEOUT_SECONDS=5
CURL_MAX_TIME_SECONDS=20
CURL_RETRIES=2
CURL_RETRY_DELAY_SECONDS=1

# Set to 1 for bounded, control-character-cleaned Codex/curl diagnostics.
MONITOR_DEBUG=0

# ----------------------------------------------------------------------------
# External Dashboard (optional — Tier 2, GitHub Gist + GitHub Pages)
# ----------------------------------------------------------------------------
# Leave blank to skip Gist sync entirely. Only curl and a GitHub account needed.
#
# 1. Create a secret Gist at https://gist.github.com (add any file, e.g. data.json)
# 2. Copy the Gist ID from the URL: gist.github.com/<username>/<GIST_ID>
# 3. Create a Personal Access Token at https://github.com/settings/tokens
#    → scope required: gist (read/write)
GITHUB_PAT=
GITHUB_GIST_ID=

# Advanced/test overrides. HTTP is accepted for loopback test servers; use HTTPS
# for real services. Base URLs must not include query strings or credentials.
GITHUB_API_URL=https://api.github.com
TELEGRAM_API_URL=https://api.telegram.org
