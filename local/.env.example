# ============================================================================
# Codex Usage Monitor — Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is git-ignored — never commit it.
# ============================================================================

# ----------------------------------------------------------------------------
# Notifications (optional — works 100% locally via direct curl, no server needed)
# ----------------------------------------------------------------------------

# Discord: create a webhook in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK=

# Telegram: message @BotFather to create a bot, then get your chat_id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert thresholds: comma-separated percentages remaining that trigger alerts.
# Each threshold fires ONCE as usage drops below it (no spam).
ALERT_THRESHOLDS=75,50,25,10,5

# Rolling history window retained in history.json, regardless of poll interval.
HISTORY_RETENTION_HOURS=24

# Codex capture settings. The monitor sends /status through a PTY-backed
# interactive Codex session so slash commands work correctly in WSL.
CODEX_BIN=codex
CODEX_STATUS_TIMEOUT_SECONDS=20

# ----------------------------------------------------------------------------
# External Dashboard (optional — Tier 2, GitHub Gist + GitHub Pages)
# ----------------------------------------------------------------------------
# Leave blank to skip Gist sync entirely. Only curl and a GitHub account needed.
#
# 1. Create a secret Gist at https://gist.github.com (add any file, e.g. data.json)
# 2. Copy the Gist ID from the URL: gist.github.com/<username>/<GIST_ID>
# 3. Create a Personal Access Token at https://github.com/settings/tokens
#    → scope required: gist (read/write)
GITHUB_PAT=
GITHUB_GIST_ID=
