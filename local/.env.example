# ============================================================================
# Codex Usage Monitor — Configuration
# ============================================================================
# Copy this file to .env and fill in your values for a source checkout.
#   cp .env.example .env
#   chmod 600 .env
#
# .env is git-ignored — never commit it.
# Configuration priority is CLI > process environment > .env > built-in default.
# Installed commands instead use:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/codex-usage-monitor/.env
# This is a data file, not a shell script: command substitution, variable
# expansion and backslash escapes are never evaluated. Values occupy one line;
# surrounding quotes are removed, and spaces inside them are preserved.
# Keep UTF-8 KEY=VALUE syntax. Blank lines and leading-# comments are ignored.
# The file must be regular, owned by the current user, not a symlink, and mode
# 0600 or stricter. Let the application parse this file; never execute it.
# ============================================================================

# ----------------------------------------------------------------------------
# Notifications (optional — works 100% locally via direct curl, no server needed)
# ----------------------------------------------------------------------------

# Discord: create a webhook in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK=

# Telegram: both values are required together. chat_id is a non-zero integer
# (negative IDs are valid for groups). Get it from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert thresholds: non-empty comma-separated integers from 0 through 100.
# Each threshold fires ONCE as usage drops below it (no spam).
# Active 5-hour and weekly limit resets also fire once automatically. Alert
# state v4 records each channel independently: transient network/408/429/5xx
# failures remain retryable, while permanent 4xx failures do not.
ALERT_THRESHOLDS=75,50,25,10,5

# Optional local scripts can react to thresholds independently from Discord and
# Telegram. Indices may range from 1 to 99 and do not need to be contiguous.
# Paths must be absolute executable files; use a wrapper when arguments are
# needed. Events are: 5h:reset, weekly:reset, 5h:<0..100>, weekly:<0..100>.
# A script may handle several events, and several scripts may share an event.
# Uncomment and adjust these examples:
# ALERT_SCRIPT_1=/absolute/path/to/reset-worker.sh
# ALERT_SCRIPT_1_EVENTS=5h:reset,weekly:reset
# ALERT_SCRIPT_2=/absolute/path/to/reduce-load.sh
# ALERT_SCRIPT_2_EVENTS=5h:50,5h:25,weekly:20

# Scripts run synchronously once per matched action. Failures are warnings and
# are not retried. Timeout range: 1..1800 seconds.
ALERT_SCRIPT_TIMEOUT_SECONDS=30

# Temporal history.json window, from 0.25 through 8760 hours. Entries older than
# now minus this duration are removed regardless of polling interval. Defensive
# ceilings are 10,000 entries and 16 MiB; snapshots over 300 seconds in the
# future are rejected. Corrupt history is preserved before reconstruction.
HISTORY_RETENTION_HOURS=192

# Long-term archive stored as usage-history.sqlite3 under STATE_DIR. Limit
# samples keep full resolution for 24h, then 30-minute buckets through 7 days,
# then hourly buckets. SQLite uses WAL, bounded lock retries, integrity checks,
# and a verified .v1.bak before v1-to-v2 migration. Analytics display buckets
# are 15 minutes through 48h, 30 minutes through 30 days, then hourly.
# Default retention: 365 days. Set to 0 for unlimited retention.
ARCHIVE_RETENTION_DAYS=365

# Local token analytics are collected in the same 15-minute cycle. "auto"
# enables every detected source; use "none" to disable, or an explicit list
# such as codex,opencode. Explicitly requested missing sources fail the cycle.
TOKEN_USAGE_SOURCES=auto
# Defaults are the release/checkout pricing.json, $HOME/.codex, the standard
# XDG OpenCode data path, and $HOME/.hermes/state.db. Uncomment only to override
# with absolute paths. Pricing and database paths may not be symlinks.
# TOKEN_PRICING_FILE=/absolute/path/to/pricing.json
# CODEX_DATA_DIR=/absolute/path/to/.codex
# OPENCODE_DB_PATH=/absolute/path/to/opencode.db
# HERMES_DB_PATH=/absolute/path/to/hermes-state.db

# State defaults to local/runtime only in a source checkout. Installed commands
# use ${XDG_STATE_HOME:-$HOME/.local/state}/codex-usage-monitor; persistent state
# is not co-located with the active installed release.
# Paths must be absolute and may contain spaces, but not control characters.
# STATE_DIR=/absolute/state/directory

# Loop interval: integer from 1 through 86400 seconds. With 900, checks align
# to :00, :15, :30, and :45.
LOOP_INTERVAL=900

# Codex app-server settings. Collection is non-interactive and does not approve
# repository trust prompts or expose account identity. Timeout: 5..300 seconds.
# Python 3.9+ and system tzdata containing Europe/Paris are required.
CODEX_BIN=codex
CODEX_STATUS_TIMEOUT_SECONDS=20

# HTTP transport bounds. Connect timeout: 1..60 seconds; total timeout: 1..600
# seconds (and not less than connect timeout); retries: 0..5; initial backoff:
# 0..60 seconds. Backoff doubles after each failed attempt.
CURL_CONNECT_TIMEOUT_SECONDS=5
CURL_MAX_TIME_SECONDS=20
CURL_RETRIES=2
CURL_RETRY_DELAY_SECONDS=1

# Set to 1 for bounded, control-character-cleaned Codex/curl diagnostics.
MONITOR_DEBUG=0

# ----------------------------------------------------------------------------
# External Dashboard (optional — Tier 2, GitHub Gist + GitHub Pages)
# ----------------------------------------------------------------------------
# Leave blank to skip Gist sync entirely. Only curl and a GitHub account needed.
#
# 1. Create a secret Gist at https://gist.github.com (add data.json containing {}).
#    "Secret" means unlisted, not private: anyone with its URL/ID can read it.
# 2. Copy the Gist ID from the URL: gist.github.com/<username>/<GIST_ID>
# 3. Create a Personal Access Token at https://github.com/settings/tokens
#    → scope required: gist (read/write)
GITHUB_PAT=
GITHUB_GIST_ID=

# Advanced/test overrides. HTTP is accepted for loopback test servers; use HTTPS
# for real services. Base URLs must not include query strings or credentials.
GITHUB_API_URL=https://api.github.com
TELEGRAM_API_URL=https://api.telegram.org
