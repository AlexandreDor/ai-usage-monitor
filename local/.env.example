# Codex Usage Monitor — complete configuration reference
# Copy to local/.env, edit values, then protect it with: chmod 600 .env
# The monitor parses this file as data; it never executes it as shell code.

# -----------------------------------------------------------------------------
# Notifications and alerting
# -----------------------------------------------------------------------------

# Default: empty (disabled). Accepted: official Discord HTTPS webhook URL.
DISCORD_WEBHOOK=

# Default: both empty (disabled). Accepted: Telegram bot token and a non-zero
# numeric chat ID; negative IDs are valid. Both values must be set together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default: 75,50,25,10,5. Accepted: a non-empty comma-separated list of
# integers from 0 to 100. Each remaining-quota threshold is handled once per
# active 5-hour and weekly cycle.
ALERT_THRESHOLDS=75,50,25,10,5

# Default: no local alert scripts. Accepted indices: 1 through 99, sparse or
# contiguous. Each configured path must be an absolute executable regular file
# and must have a matching _EVENTS value. Accepted events are 5h:reset,
# weekly:reset, 5h:<0..100>, and weekly:<0..100>. Uncomment to enable examples.
# ALERT_SCRIPT_1=/home/youruser/codex-usage-monitor/local/scripts/reset-worker.sh
# ALERT_SCRIPT_1_EVENTS=5h:reset,weekly:reset
# ALERT_SCRIPT_2=/home/youruser/codex-usage-monitor/local/scripts/reduce-load.sh
# ALERT_SCRIPT_2_EVENTS=5h:50,5h:25,weekly:20

# Default: 30. Accepted: integer from 1 to 1800 seconds. Applies to every local
# alert script; failures and timeouts are warnings and are not retried.
ALERT_SCRIPT_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Collection, history, and local analytics
# -----------------------------------------------------------------------------

# Default: 900. Accepted: integer from 1 to 86400 seconds. At 900, loop mode
# aligns checks with :00, :15, :30, and :45.
LOOP_INTERVAL=900

# Default: 300. Accepted: integer from 30 to 86400 seconds. While at least one
# locally served dashboard tab is visible, quota snapshots and alerts use this
# cadence without adding history, SQLite, Forecast, token, graph, or Gist data.
DASHBOARD_ACTIVE_INTERVAL_SECONDS=300

# Default: 192. Accepted: finite number from 0.25 to 8760 hours. Controls the
# age-based rolling history.json window; 10,000-entry and 16 MiB safety limits
# can shorten it.
HISTORY_RETENTION_HOURS=192

# Default: 365. Accepted: integer from 0 to 36500 days. Controls quota,
# Forecast, reset, and token retention in SQLite; 0 keeps data indefinitely.
ARCHIVE_RETENTION_DAYS=365

# Default: auto. Accepted: auto, none, or a comma-separated subset of
# codex,opencode,hermes. auto ignores missing optional sources; an explicitly
# requested missing source degrades the collection cycle.
TOKEN_USAGE_SOURCES=auto

# Default: <repository>/local/pricing.json. Accepted: absolute path to a
# readable regular JSON file that is not a symlink. Uncomment only to override.
# TOKEN_PRICING_FILE=/absolute/path/to/codex-usage-monitor/local/pricing.json

# Default: $HOME/.codex. Accepted: absolute path without control characters.
# CODEX_DATA_DIR=/home/youruser/.codex

# Default: $XDG_DATA_HOME/opencode/opencode.db when XDG_DATA_HOME is set,
# otherwise $HOME/.local/share/opencode/opencode.db. Accepted: absolute path.
# OPENCODE_DB_PATH=/home/youruser/.local/share/opencode/opencode.db

# Default: $HOME/.hermes/state.db. Accepted: absolute path.
# HERMES_DB_PATH=/home/youruser/.hermes/state.db

# Default: codex. Accepted: executable name or path used to launch the Codex
# app-server status request.
CODEX_BIN=codex

# Default: 20. Accepted: integer from 5 to 300 seconds.
CODEX_STATUS_TIMEOUT_SECONDS=20

# Default: 0 (disabled). Accepted: 0 or 1. Enables bounded and
# control-character-cleaned Codex/curl diagnostics when set to 1.
MONITOR_DEBUG=0

# -----------------------------------------------------------------------------
# Codex Forecast (optional third-party request)
# -----------------------------------------------------------------------------

# Default: 1 (enabled). Accepted: 0 or 1. Fetches global 24-hour and 6-hour
# reset probabilities once per monitor cycle. Failure never fails quota
# collection; valid observations are retained in history.json and SQLite.
CODEX_FORECAST_ENABLED=1

# Default: 50. Accepted: integer from 0 to 100. The current 24-hour Forecast
# value is highlighted when it is greater than or equal to this percentage.
CODEX_FORECAST_24H_HIGHLIGHT_THRESHOLD=50

# Default: 25. Accepted: integer from 0 to 100. The current 6-hour Forecast
# value is highlighted when it is greater than or equal to this percentage.
CODEX_FORECAST_6H_HIGHLIGHT_THRESHOLD=25

# -----------------------------------------------------------------------------
# HTTP behavior
# -----------------------------------------------------------------------------

# Default: 5. Accepted: integer from 1 to 60 seconds.
CURL_CONNECT_TIMEOUT_SECONDS=5

# Default: 20. Accepted: integer from 1 to 600 seconds and not lower than
# CURL_CONNECT_TIMEOUT_SECONDS.
CURL_MAX_TIME_SECONDS=20

# Default: 2. Accepted: integer from 0 to 5 retries for temporary failures.
CURL_RETRIES=2

# Default: 1. Accepted: integer from 0 to 60 seconds. Retry backoff doubles
# after each attempt.
CURL_RETRY_DELAY_SECONDS=1

# -----------------------------------------------------------------------------
# External dashboard through GitHub Gist
# -----------------------------------------------------------------------------

# Default: both empty (disabled). Accepted: a GitHub token with Gist access and
# a hexadecimal Gist ID. Both values must be set together. The Gist receives
# sanitized data.json and history.json, never SQLite or local token analytics.
GITHUB_PAT=
GITHUB_GIST_ID=

# Default: https://api.github.com. Accepted: HTTP(S) base URL without query,
# credentials, or control characters. HTTP is intended only for loopback tests.
GITHUB_API_URL=https://api.github.com

# Default: https://api.telegram.org. Accepted: HTTP(S) base URL without query,
# credentials, or control characters. Primarily useful for compatible test APIs.
TELEGRAM_API_URL=https://api.telegram.org

# -----------------------------------------------------------------------------
# Environment-only overrides — NOT read from local/.env
# -----------------------------------------------------------------------------
# Export these in the process environment when needed; do not uncomment them in
# this file expecting monitor.sh or serve.sh to load them.

# DASHBOARD_ANALYTICS_DATABASE
# Default: <repository>/local/runtime/usage-history.sqlite3.
# Absolute, non-symlink SQLite database path used only by serve.sh.

# DASHBOARD_PRICING_FILE
# Default: TOKEN_PRICING_FILE from the process environment, then the value that
# serve.sh reads for TOKEN_PRICING_FILE from local/.env, then local/pricing.json.
# Absolute readable regular pricing file used only by serve.sh.

# CODEX_BIN_OVERRIDE
# Default: empty. Process-only override that takes precedence over CODEX_BIN
# during monitor initialization; intended for controlled wrappers and tests.

# GIST_ID is not an environment or .env setting. It is the static client
# constant near the top of local/assets/dashboard.js for GitHub Pages mode.
# Likewise, serve.sh --port and --bind are command-line options, not .env keys.
